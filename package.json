{
  "name": "ferrel-forge",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ferrel/db generate",
    "db:migrate": "pnpm --filter @ferrel/db migrate",
    "db:studio": "pnpm --filter @ferrel/db studio",
    "storage:setup": "pnpm --filter @ferrel/storage run setup-buckets",
    "test:integration": "pnpm --filter @ferrel/web run test:integration",
    "e2e": "pnpm --filter @ferrel/e2e run e2e",
    "audio:fetch": "pnpm --filter @ferrel/audio run fetch-ffmpeg"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "turbo": "^2.11.8",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}
