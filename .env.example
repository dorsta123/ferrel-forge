# Copy to .env and adjust. Values match docker-compose.yml defaults.
DATABASE_URL=postgres://ferrel:ferrel@localhost:5432/ferrel
REDIS_URL=redis://localhost:6379

# RustFS (local S3-compatible storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ferrel
S3_SECRET_KEY=ferrelsecret
S3_BUCKET_MASTERS=masters
S3_BUCKET_PREVIEWS=previews

# Better Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

S3_REGION=us-east-1
# Browser origins allowed to upload straight to storage (comma-separated)
S3_CORS_ORIGINS=http://localhost:3000
