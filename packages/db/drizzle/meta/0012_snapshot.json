        },
        "tracks_audio_all_or_none": {
          "name": "tracks_audio_all_or_none",
          "value": "(\"tracks\".\"audio_key\" is null) = (\"tracks\".\"audio_size_bytes\" is null) and (\"tracks\".\"audio_key\" is null) = (\"tracks\".\"audio_format\" is null)"
        },
        "tracks_audio_size": {
          "name": "tracks_audio_size",
          "value": "\"tracks\".\"audio_size_bytes\" is null or \"tracks\".\"audio_size_bytes\" between 1 and 157286400"
        },
        "tracks_audio_status_matches_file": {
          "name": "tracks_audio_status_matches_file",
          "value": "(\"tracks\".\"audio_key\" is null) = (\"tracks\".\"audio_status\" = 'none')"
        },
        "tracks_audio_ready_has_length": {
          "name": "tracks_audio_ready_has_length",
          "value": "\"tracks\".\"audio_status\" <> 'ready' or \"tracks\".\"duration_ms\" is not null"
        },
        "tracks_audio_error": {
          "name": "tracks_audio_error",
          "value": "(\"tracks\".\"audio_status\" = 'failed') = (\"tracks\".\"audio_error\" is not null)\n        and (\"tracks\".\"audio_error\" is null or (\"tracks\".\"audio_error\" ~ '[^[:space:]]' and char_length(\"tracks\".\"audio_error\") <= 500))"
        },
        "tracks_audio_results_need_file": {
          "name": "tracks_audio_results_need_file",
          "value": "\"tracks\".\"audio_key\" is not null or (\"tracks\".\"duration_ms\" is null and \"tracks\".\"preview_key\" is null and \"tracks\".\"preview_start_ms\" is null and \"tracks\".\"waveform\" is null)"
        },
        "tracks_preview_off_no_file": {
          "name": "tracks_preview_off_no_file",
          "value": "\"tracks\".\"preview_enabled\" or \"tracks\".\"preview_key\" is null"
        },
        "tracks_preview_start": {
          "name": "tracks_preview_start",
          "value": "\"tracks\".\"preview_start_ms\" is null or (\"tracks\".\"duration_ms\" is not null and \"tracks\".\"preview_start_ms\" >= 0\n        and \"tracks\".\"preview_start_ms\" <= greatest(\"tracks\".\"duration_ms\" - 15000, 0))"
        },
        "tracks_waveform_shape": {
          "name": "tracks_waveform_shape",
          "value": "\"tracks\".\"waveform\" is null or (array_ndims(\"tracks\".\"waveform\") = 1 and cardinality(\"tracks\".\"waveform\") = 200\n        and array_position(\"tracks\".\"waveform\", null) is null\n        and 0 <= all(\"tracks\".\"waveform\") and 1000 >= all(\"tracks\".\"waveform\"))"
        },
        "tracks_listen_url": {
          "name": "tracks_listen_url",
          "value": "\"tracks\".\"listen_url\" is null or (char_length(\"tracks\".\"listen_url\") <= 300\n        and \"tracks\".\"listen_url\" ~ '^https://(youtube[.]com|www[.]youtube[.]com|m[.]youtube[.]com|music[.]youtube[.]com|youtu[.]be|open[.]spotify[.]com|soundcloud[.]com|www[.]soundcloud[.]com|m[.]soundcloud[.]com)/[^[:space:]]+$')"
        },
        "tracks_live_needs_audio": {
          "name": "tracks_live_needs_audio",
          "value": "\"tracks\".\"status\" = 'draft' or (\"tracks\".\"audio_key\" is not null and \"tracks\".\"published_at\" is not null)"
        }
      },
      "isRLSEnabled": false
